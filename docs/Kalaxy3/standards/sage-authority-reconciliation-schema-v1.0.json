{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kalaxy3.local/sage-authority-reconciliation-schema-v1.0.json",
    "title": "Kalaxy3 SAGE authority reconciliation receipt",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "receipt_id",
        "request",
        "captured_at",
        "repository",
        "assertions",
        "conflicts",
        "unknowns",
        "reconciliation",
        "mutation_gate",
        "evidence_references"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "receipt_id": {
            "type": "string",
            "pattern": "^SAGE-AUTH-[0-9]{8}-[0-9]{3}$"
        },
        "request": {
            "type": "string",
            "minLength": 1
        },
        "captured_at": {
            "type": "string",
            "format": "date-time"
        },
        "repository": {
            "$ref": "#/$defs/repository"
        },
        "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/assertion"
            }
        },
        "conflicts": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/conflict"
            }
        },
        "unknowns": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/unknown"
            }
        },
        "reconciliation": {
            "$ref": "#/$defs/reconciliation"
        },
        "mutation_gate": {
            "$ref": "#/$defs/mutation_gate"
        },
        "evidence_references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    },
    "$defs": {
        "sha40": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "branch",
                "head",
                "upstream_head",
                "working_tree_clean"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "branch": {
                    "type": "string",
                    "minLength": 1
                },
                "head": {
                    "$ref": "#/$defs/sha40"
                },
                "upstream_head": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/sha40"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "working_tree_clean": {
                    "type": "boolean"
                }
            }
        },
        "assertion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "assertion_id",
                "authority_type",
                "source_kind",
                "reference",
                "captured_at",
                "freshness",
                "statement",
                "measurement_type",
                "confidence",
                "applicability",
                "evidence_sha256"
            ],
            "properties": {
                "assertion_id": {
                    "type": "string",
                    "pattern": "^AUTH-[0-9]{3}$"
                },
                "authority_type": {
                    "enum": [
                        "operator-intent",
                        "git",
                        "github",
                        "repository-policy",
                        "sage",
                        "runtime",
                        "telemetry",
                        "economics",
                        "external-contract"
                    ]
                },
                "source_kind": {
                    "enum": [
                        "direct-observation",
                        "repository",
                        "api",
                        "runtime",
                        "telemetry",
                        "manual",
                        "inference"
                    ]
                },
                "reference": {
                    "type": "string",
                    "minLength": 1
                },
                "captured_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "freshness": {
                    "enum": [
                        "current",
                        "stale",
                        "unknown",
                        "not-applicable"
                    ]
                },
                "statement": {
                    "type": "string",
                    "minLength": 1
                },
                "measurement_type": {
                    "enum": [
                        "measured",
                        "declared",
                        "inferred",
                        "unavailable"
                    ]
                },
                "confidence": {
                    "enum": [
                        "high",
                        "medium",
                        "low",
                        "not-recorded"
                    ]
                },
                "applicability": {
                    "enum": [
                        "material",
                        "supporting",
                        "not-applicable",
                        "unknown"
                    ]
                },
                "evidence_sha256": {
                    "oneOf": [
                        {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "conflict": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "conflict_id",
                "assertion_ids",
                "summary",
                "materiality",
                "resolution_status",
                "resolution"
            ],
            "properties": {
                "conflict_id": {
                    "type": "string",
                    "pattern": "^CONFLICT-[0-9]{3}$"
                },
                "assertion_ids": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^AUTH-[0-9]{3}$"
                    }
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "materiality": {
                    "enum": [
                        "blocking",
                        "non-blocking"
                    ]
                },
                "resolution_status": {
                    "enum": [
                        "unresolved",
                        "resolved",
                        "accepted-risk"
                    ]
                },
                "resolution": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "unknown": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "unknown_id",
                "subject",
                "materiality",
                "resolution_required",
                "reason"
            ],
            "properties": {
                "unknown_id": {
                    "type": "string",
                    "pattern": "^UNKNOWN-[0-9]{3}$"
                },
                "subject": {
                    "type": "string",
                    "minLength": 1
                },
                "materiality": {
                    "enum": [
                        "blocking",
                        "non-blocking"
                    ]
                },
                "resolution_required": {
                    "type": "boolean"
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "reconciliation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "disposition",
                "material_authority_complete",
                "source_assertions_separate_from_inference",
                "summary"
            ],
            "properties": {
                "disposition": {
                    "enum": [
                        "complete",
                        "incomplete",
                        "conflicting",
                        "stale",
                        "unavailable"
                    ]
                },
                "material_authority_complete": {
                    "type": "boolean"
                },
                "source_assertions_separate_from_inference": {
                    "const": true
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "mutation_gate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "reason",
                "operator_approval_required",
                "mutation_performed"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "blocked",
                        "review-ready"
                    ]
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                },
                "operator_approval_required": {
                    "const": true
                },
                "mutation_performed": {
                    "const": false
                }
            }
        }
    }
}
