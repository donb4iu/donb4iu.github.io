{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "markdown/standards/sage-request-execution-proposal-schema-v1.0.json",
    "title": "Kalaxy3 SAGE request execution proposal package",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "request_sha256",
        "repository",
        "source_files",
        "generated_paths",
        "reconcile_evidence_index",
        "evidence_references",
        "capabilities",
        "candidates",
        "new_primitive_required",
        "validation_commands",
        "operator_plan"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "branch",
                "head"
            ],
            "properties": {
                "branch": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                        "const": "main"
                    }
                },
                "head": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
            }
        },
        "source_files": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "sha256",
                    "mode"
                ],
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "mode": {
                        "enum": [
                            "0644",
                            "0755"
                        ]
                    }
                }
            }
        },
        "generated_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "reconcile_evidence_index": {
            "type": "boolean"
        },
        "evidence_references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "capability_id",
                    "description",
                    "required"
                ],
                "properties": {
                    "capability_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1
                    },
                    "required": {
                        "type": "boolean"
                    }
                }
            }
        },
        "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "candidate_id",
                    "capability_ids",
                    "component_id",
                    "version",
                    "source_path",
                    "maturity",
                    "selection_factors",
                    "evidence_references",
                    "rationale"
                ],
                "properties": {
                    "candidate_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "capability_ids": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "component_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1
                    },
                    "source_path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "maturity": {
                        "type": "string",
                        "minLength": 1
                    },
                    "selection_factors": {
                        "type": "object"
                    },
                    "evidence_references": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "rationale": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "new_primitive_required": {
            "const": false
        },
        "validation_commands": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "label",
                    "argv"
                ],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1
                    },
                    "argv": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "prefixItems": [
                            {
                                "const": "make"
                            },
                            {
                                "type": "string",
                                "pattern": "^sage-[a-z0-9][a-z0-9-]*$"
                            }
                        ]
                    },
                    "timeout_seconds": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 3600
                    }
                }
            }
        },
        "operator_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commit_message",
                "push_remote"
            ],
            "properties": {
                "commit_message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[^\\r\\n]+$"
                },
                "push_remote": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
            }
        }
    }
}
