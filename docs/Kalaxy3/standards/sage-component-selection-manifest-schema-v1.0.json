{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kalaxy3.local/sage-component-selection-manifest-schema-v1.0.json",
    "title": "Kalaxy3 SAGE component selection and composition manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "manifest_id",
        "request",
        "created_at",
        "authority_receipt",
        "required_capabilities",
        "candidates",
        "selections",
        "composition",
        "capability_gap_receipts",
        "approval",
        "composite_score_enabled"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "manifest_id": {
            "type": "string",
            "pattern": "^SAGE-COMP-[0-9]{8}-[0-9]{3}$"
        },
        "request": {
            "type": "string",
            "minLength": 1
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "authority_receipt": {
            "type": "string",
            "minLength": 1
        },
        "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/capability"
            }
        },
        "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/candidate"
            }
        },
        "selections": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/selection"
            }
        },
        "composition": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/step"
            }
        },
        "capability_gap_receipts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^SAGE-GAP-[0-9]{8}-[0-9]{3}$"
            }
        },
        "approval": {
            "$ref": "#/$defs/approval"
        },
        "composite_score_enabled": {
            "const": false
        }
    },
    "$defs": {
        "capability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "capability_id",
                "description",
                "required"
            ],
            "properties": {
                "capability_id": {
                    "type": "string",
                    "pattern": "^CAP-[0-9]{3}$"
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "required": {
                    "type": "boolean"
                }
            }
        },
        "candidate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "candidate_id",
                "capability_ids",
                "component_id",
                "version",
                "source_path",
                "maturity",
                "disposition",
                "selection_factors",
                "evidence_references",
                "rationale"
            ],
            "properties": {
                "candidate_id": {
                    "type": "string",
                    "pattern": "^CANDIDATE-[0-9]{3}$"
                },
                "capability_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^CAP-[0-9]{3}$"
                    }
                },
                "component_id": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "source_path": {
                    "type": "string",
                    "minLength": 1
                },
                "maturity": {
                    "enum": [
                        "pilot",
                        "validated",
                        "stable",
                        "deprecated",
                        "unregistered"
                    ]
                },
                "disposition": {
                    "enum": [
                        "selected",
                        "rejected",
                        "gap"
                    ]
                },
                "selection_factors": {
                    "$ref": "#/$defs/factors"
                },
                "evidence_references": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "rationale": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "factors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "applicability",
                "authority_compatibility",
                "mutation_scope_fit",
                "published_interface_verified",
                "successful_production_executions",
                "failed_production_executions",
                "open_recurrence",
                "runtime_test_coverage"
            ],
            "properties": {
                "applicability": {
                    "enum": [
                        "direct",
                        "partial",
                        "none",
                        "unknown"
                    ]
                },
                "authority_compatibility": {
                    "enum": [
                        "compatible",
                        "conflicting",
                        "unknown"
                    ]
                },
                "mutation_scope_fit": {
                    "enum": [
                        "least-authority",
                        "broader-than-required",
                        "insufficient",
                        "unknown"
                    ]
                },
                "published_interface_verified": {
                    "type": "boolean"
                },
                "successful_production_executions": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "failed_production_executions": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "open_recurrence": {
                    "enum": [
                        "yes",
                        "no",
                        "unknown"
                    ]
                },
                "runtime_test_coverage": {
                    "enum": [
                        "positive-and-negative",
                        "positive-only",
                        "source-only",
                        "none",
                        "unknown"
                    ]
                }
            }
        },
        "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "capability_id",
                "candidate_id",
                "component_id",
                "version",
                "selection_basis"
            ],
            "properties": {
                "capability_id": {
                    "type": "string",
                    "pattern": "^CAP-[0-9]{3}$"
                },
                "candidate_id": {
                    "type": "string",
                    "pattern": "^CANDIDATE-[0-9]{3}$"
                },
                "component_id": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "selection_basis": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "step": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sequence",
                "step_id",
                "capability_id",
                "component_id",
                "version",
                "purpose",
                "side_effect_scope"
            ],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1
                },
                "step_id": {
                    "type": "string",
                    "minLength": 1
                },
                "capability_id": {
                    "type": "string",
                    "pattern": "^CAP-[0-9]{3}$"
                },
                "component_id": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "purpose": {
                    "type": "string",
                    "minLength": 1
                },
                "side_effect_scope": {
                    "enum": [
                        "read-only",
                        "local-state",
                        "repository-content",
                        "operator-proposal",
                        "temporary-fixture"
                    ]
                }
            }
        },
        "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "reviewed_by",
                "reviewed_at",
                "rationale"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "review-required",
                        "approved",
                        "rejected"
                    ]
                },
                "reviewed_by": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reviewed_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "rationale": {
                    "type": "string"
                }
            }
        }
    }
}
