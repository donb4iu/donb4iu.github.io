{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "markdown/standards/sage-capability-gap-receipt-schema-v1.1.json",
  "title": "Kalaxy3 SAGE domain capability gap receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gap_id",
    "request",
    "created_at",
    "authority_receipt",
    "component_manifest",
    "required_capability",
    "gap_kind",
    "candidates_considered",
    "gap",
    "proposed_primitive",
    "approval",
    "evidence_references"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "gap_id": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_receipt": {
      "type": "string",
      "minLength": 1
    },
    "component_manifest": {
      "type": "string",
      "minLength": 1
    },
    "required_capability": {
      "type": "string",
      "minLength": 1
    },
    "gap_kind": {
      "const": "domain-capability"
    },
    "candidates_considered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_interface_or_behavior",
        "why_configuration_is_insufficient",
        "why_composition_is_insufficient",
        "new_primitive_required",
        "new_domain_capability_required"
      ],
      "properties": {
        "missing_interface_or_behavior": {
          "type": "string",
          "minLength": 1
        },
        "why_configuration_is_insufficient": {
          "type": "string",
          "minLength": 1
        },
        "why_composition_is_insufficient": {
          "type": "string",
          "minLength": 1
        },
        "new_primitive_required": {
          "const": false
        },
        "new_domain_capability_required": {
          "const": true
        }
      }
    },
    "proposed_primitive": {
      "type": "null"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "version",
        "source_path",
        "insufficiency",
        "composition_can_close_gap"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "insufficiency": {
          "type": "string",
          "minLength": 1
        },
        "composition_can_close_gap": {
          "type": "boolean"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_by",
        "reviewed_at",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "review-required",
            "approved",
            "rejected"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}
