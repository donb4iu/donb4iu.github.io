{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kalaxy3.local/sage-improvement-action-schema-v1.2.json",
    "title": "Kalaxy3 SAGE improvement-action registry 1.2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "registry_type",
        "actions"
    ],
    "properties": {
        "schema_version": {
            "const": "1.2"
        },
        "registry_type": {
            "const": "improvement-actions"
        },
        "actions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/action"
            }
        }
    },
    "$defs": {
        "status": {
            "enum": [
                "identified",
                "accepted",
                "implemented",
                "validated",
                "measured",
                "closed",
                "rejected"
            ]
        },
        "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "action_id",
                "title",
                "source_lessons",
                "source_sessions",
                "current_status",
                "owner",
                "priority",
                "target_control_type",
                "desired_outcome",
                "acceptance_criteria",
                "measurement_plan",
                "history"
            ],
            "properties": {
                "action_id": {
                    "type": "string",
                    "pattern": "^SAGE-ACTION-[0-9]{8}-[0-9]{3}$"
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "source_lessons": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^SAGE-LESSON-[0-9]{8}-[0-9]{3}$"
                    }
                },
                "source_sessions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^SAGE-SESSION-[0-9]{8}-[0-9]{3}$"
                    }
                },
                "source_records": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/source_record"
                    }
                },
                "current_status": {
                    "$ref": "#/$defs/status"
                },
                "owner": {
                    "type": "string",
                    "minLength": 1
                },
                "priority": {
                    "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                    ]
                },
                "target_control_type": {
                    "enum": [
                        "manual",
                        "template",
                        "preflight",
                        "guardrail",
                        "runbook",
                        "automation",
                        "no-action"
                    ]
                },
                "desired_outcome": {
                    "type": "string",
                    "minLength": 1
                },
                "acceptance_criteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "measurement_plan": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "history": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/event"
                    }
                }
            },
            "anyOf": [
                {
                    "properties": {
                        "source_lessons": {
                            "minItems": 1
                        }
                    },
                    "required": [
                        "source_lessons"
                    ]
                },
                {
                    "properties": {
                        "source_sessions": {
                            "minItems": 1
                        }
                    },
                    "required": [
                        "source_sessions"
                    ]
                },
                {
                    "properties": {
                        "source_records": {
                            "minItems": 1
                        }
                    },
                    "required": [
                        "source_records"
                    ]
                }
            ]
        },
        "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sequence",
                "from_status",
                "to_status",
                "transition_type",
                "recorded_at",
                "actor",
                "reason",
                "evidence_references"
            ],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1
                },
                "from_status": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/status"
                        }
                    ]
                },
                "to_status": {
                    "$ref": "#/$defs/status"
                },
                "transition_type": {
                    "enum": [
                        "initial-registration",
                        "status-transition",
                        "contract-amendment"
                    ]
                },
                "recorded_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "actor": {
                    "type": "string",
                    "minLength": 1
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                },
                "evidence_references": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "amendment": {
                    "$ref": "#/$defs/amendment"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "transition_type": {
                                "const": "contract-amendment"
                            }
                        },
                        "required": [
                            "transition_type"
                        ]
                    },
                    "then": {
                        "required": [
                            "amendment"
                        ],
                        "properties": {
                            "from_status": {
                                "const": "identified"
                            },
                            "to_status": {
                                "const": "identified"
                            }
                        }
                    },
                    "else": {
                        "not": {
                            "required": [
                                "amendment"
                            ]
                        }
                    }
                }
            ]
        },
        "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "action_id",
                "title",
                "source_lessons",
                "source_sessions",
                "owner",
                "priority",
                "target_control_type",
                "desired_outcome",
                "acceptance_criteria",
                "measurement_plan"
            ],
            "properties": {
                "action_id": {
                    "type": "string",
                    "pattern": "^SAGE-ACTION-[0-9]{8}-[0-9]{3}$"
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "source_lessons": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^SAGE-LESSON-[0-9]{8}-[0-9]{3}$"
                    }
                },
                "source_sessions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^SAGE-SESSION-[0-9]{8}-[0-9]{3}$"
                    }
                },
                "source_records": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/source_record"
                    }
                },
                "owner": {
                    "type": "string",
                    "minLength": 1
                },
                "priority": {
                    "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                    ]
                },
                "target_control_type": {
                    "enum": [
                        "manual",
                        "template",
                        "preflight",
                        "guardrail",
                        "runbook",
                        "automation",
                        "no-action"
                    ]
                },
                "desired_outcome": {
                    "type": "string",
                    "minLength": 1
                },
                "acceptance_criteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "measurement_plan": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "anyOf": [
                {
                    "properties": {
                        "source_lessons": {
                            "minItems": 1
                        }
                    },
                    "required": [
                        "source_lessons"
                    ]
                },
                {
                    "properties": {
                        "source_sessions": {
                            "minItems": 1
                        }
                    },
                    "required": [
                        "source_sessions"
                    ]
                },
                {
                    "properties": {
                        "source_records": {
                            "minItems": 1
                        }
                    },
                    "required": [
                        "source_records"
                    ]
                }
            ]
        },
        "amendment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "changed_fields",
                "before_contract",
                "after_contract",
                "before_contract_sha256",
                "after_contract_sha256"
            ],
            "properties": {
                "changed_fields": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "title",
                            "source_lessons",
                            "source_sessions",
                            "source_records",
                            "owner",
                            "priority",
                            "target_control_type",
                            "desired_outcome",
                            "acceptance_criteria",
                            "measurement_plan"
                        ]
                    }
                },
                "before_contract": {
                    "$ref": "#/$defs/contract"
                },
                "after_contract": {
                    "$ref": "#/$defs/contract"
                },
                "before_contract_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "after_contract_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        },
        "source_record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "record_type",
                "record_id",
                "schema_version",
                "sha256"
            ],
            "properties": {
                "record_type": {
                    "const": "capability-gap"
                },
                "record_id": {
                    "type": "string",
                    "pattern": "^SAGE-GAP-[0-9]{8}-[A-Z0-9][A-Z0-9-]*$"
                },
                "schema_version": {
                    "const": "1.1"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        }
    }
}
