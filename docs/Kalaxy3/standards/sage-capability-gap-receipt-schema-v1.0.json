{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kalaxy3.local/sage-capability-gap-receipt-schema-v1.0.json",
    "title": "Kalaxy3 SAGE capability gap receipt",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "gap_id",
        "request",
        "created_at",
        "authority_receipt",
        "component_manifest",
        "required_capability",
        "candidates_considered",
        "gap",
        "proposed_primitive",
        "approval",
        "evidence_references"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "gap_id": {
            "type": "string",
            "pattern": "^SAGE-GAP-[0-9]{8}-[0-9]{3}$"
        },
        "request": {
            "type": "string",
            "minLength": 1
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "authority_receipt": {
            "type": "string",
            "minLength": 1
        },
        "component_manifest": {
            "type": "string",
            "minLength": 1
        },
        "required_capability": {
            "type": "string",
            "minLength": 1
        },
        "candidates_considered": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/candidate"
            }
        },
        "gap": {
            "$ref": "#/$defs/gap"
        },
        "proposed_primitive": {
            "$ref": "#/$defs/primitive"
        },
        "approval": {
            "$ref": "#/$defs/approval"
        },
        "evidence_references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    },
    "$defs": {
        "candidate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "component_id",
                "version",
                "source_path",
                "insufficiency",
                "composition_can_close_gap"
            ],
            "properties": {
                "component_id": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "source_path": {
                    "type": "string",
                    "minLength": 1
                },
                "insufficiency": {
                    "type": "string",
                    "minLength": 1
                },
                "composition_can_close_gap": {
                    "type": "boolean"
                }
            }
        },
        "gap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "missing_interface_or_behavior",
                "why_configuration_is_insufficient",
                "why_composition_is_insufficient",
                "new_primitive_required"
            ],
            "properties": {
                "missing_interface_or_behavior": {
                    "type": "string",
                    "minLength": 1
                },
                "why_configuration_is_insufficient": {
                    "type": "string",
                    "minLength": 1
                },
                "why_composition_is_insufficient": {
                    "type": "string",
                    "minLength": 1
                },
                "new_primitive_required": {
                    "type": "boolean"
                }
            }
        },
        "primitive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "primitive_id",
                "responsibility",
                "side_effects",
                "idempotency",
                "logging",
                "failure_mode",
                "runtime_tests",
                "initial_maturity"
            ],
            "properties": {
                "primitive_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9.-]+$"
                },
                "responsibility": {
                    "type": "string",
                    "minLength": 1
                },
                "side_effects": {
                    "type": "string",
                    "minLength": 1
                },
                "idempotency": {
                    "type": "string",
                    "minLength": 1
                },
                "logging": {
                    "type": "string",
                    "minLength": 1
                },
                "failure_mode": {
                    "type": "string",
                    "minLength": 1
                },
                "runtime_tests": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "initial_maturity": {
                    "const": "pilot"
                }
            }
        },
        "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "reviewed_by",
                "reviewed_at",
                "rationale"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "review-required",
                        "approved",
                        "rejected"
                    ]
                },
                "reviewed_by": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reviewed_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "rationale": {
                    "type": "string"
                }
            }
        }
    }
}
