{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kalaxy3.local/sage-operator-git-proposal-schema-v1.1.json",
    "title": "Kalaxy3 SAGE browser-backed operator GitHub mutation proposal",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "proposal_id",
        "created_at",
        "controller",
        "repository",
        "authority_receipt",
        "component_manifest",
        "boundary",
        "change_scope",
        "validation",
        "browser",
        "expected_result",
        "risk",
        "rollback",
        "post_interaction_verification",
        "operator_contract"
    ],
    "properties": {
        "schema_version": {
            "const": "1.1"
        },
        "proposal_id": {
            "type": "string",
            "pattern": "^SAGE-GIT-[0-9]{8}-[0-9]{3}$"
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "controller": {
            "type": "string",
            "minLength": 1
        },
        "repository": {
            "$ref": "#/$defs/repository"
        },
        "authority_receipt": {
            "type": "string",
            "minLength": 1
        },
        "component_manifest": {
            "type": "string",
            "minLength": 1
        },
        "boundary": {
            "enum": [
                "pull-request-create",
                "pull-request-merge"
            ]
        },
        "change_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "validation": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/validation"
            }
        },
        "browser": {
            "$ref": "#/$defs/browser"
        },
        "expected_result": {
            "type": "string",
            "minLength": 1
        },
        "risk": {
            "type": "string",
            "minLength": 1
        },
        "rollback": {
            "type": "string",
            "minLength": 1
        },
        "post_interaction_verification": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "operator_contract": {
            "$ref": "#/$defs/operator"
        }
    },
    "$defs": {
        "sha40": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "branch",
                "head",
                "upstream_head",
                "working_tree_status"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "branch": {
                    "type": "string",
                    "minLength": 1
                },
                "head": {
                    "$ref": "#/$defs/sha40"
                },
                "upstream_head": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/sha40"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "working_tree_status": {
                    "enum": [
                        "clean",
                        "declared-changes",
                        "staged-declared-changes"
                    ]
                }
            }
        },
        "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "label",
                "status",
                "reference",
                "sha256"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "const": "pass"
                },
                "reference": {
                    "type": "string",
                    "minLength": 1
                },
                "sha256": {
                    "oneOf": [
                        {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "browser": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "provider",
                "action",
                "url",
                "sha256",
                "contains_secret",
                "opened_by_helper",
                "mutation_performed_by_helper"
            ],
            "properties": {
                "provider": {
                    "const": "github-browser"
                },
                "action": {
                    "enum": [
                        "create-pull-request",
                        "merge-pull-request"
                    ]
                },
                "url": {
                    "type": "string",
                    "pattern": "^https://github\\.com/"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "contains_secret": {
                    "const": false
                },
                "opened_by_helper": {
                    "const": false
                },
                "mutation_performed_by_helper": {
                    "const": false
                }
            }
        },
        "operator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "execution_mode",
                "approval_required",
                "operator_confirmation_required",
                "pasted_output_required",
                "next_boundary_blocked_until_verified"
            ],
            "properties": {
                "execution_mode": {
                    "const": "browser-review"
                },
                "approval_required": {
                    "const": true
                },
                "operator_confirmation_required": {
                    "const": true
                },
                "pasted_output_required": {
                    "const": false
                },
                "next_boundary_blocked_until_verified": {
                    "const": true
                }
            }
        }
    }
}
