{
  "schema_version": "1.0",
  "policy_id": "sage.architecture-approval-evaluation",
  "purpose": "Give the LLM broad independent influence before material Architect architecture/path approval without transferring approval authority or prescribing implementation mechanics.",
  "authority": {
    "architecture_approval": "Architect",
    "architecture_evaluation": "LLM advisory",
    "evidence_and_constraint_reconciliation": "SAGE",
    "implementation": "delegated within approved authority"
  },
  "principles": {
    "independent_evaluation_before_material_approval": true,
    "framework_guided_not_framework_bound": true,
    "broad_solution_space_required": true,
    "current_sage_capability_is_not_solution_boundary": true,
    "additional_fit_for_purpose_lenses_allowed": true,
    "checklist_completion_is_not_fitness_evidence": true,
    "opaque_aggregate_score_prohibited": true,
    "implementation_micromanagement_is_not_the_goal": true,
    "explicit_unknowns_and_limits_required": true
  },
  "evaluation_inputs": [
    "Architect-owned intent and decision surface",
    "relevant SAGE experience and evidence when available",
    "governing constraints and authority",
    "known unknowns and unresolved uncertainty"
  ],
  "framework_seeds": {
    "war": [
      "operational-excellence",
      "security",
      "reliability",
      "performance-efficiency",
      "cost-optimization",
      "sustainability"
    ],
    "caf": [
      "business",
      "people",
      "governance",
      "platform",
      "security",
      "operations"
    ],
    "other_fit_for_purpose_examples": [
      "human-factors-and-usability",
      "quality-attributes-and-tradeoffs",
      "threat-and-risk-modeling",
      "architecture-and-technology-fitness",
      "delivery-recovery-and-operability",
      "economics-and-complexity",
      "organizational-learning-and-reuse"
    ]
  },
  "service_area_seeds": [
    "stakeholder-value-and-human-factors",
    "functional-capability-and-boundaries",
    "security-resilience-and-reliability",
    "performance-scalability-and-efficiency",
    "operability-observability-and-recovery",
    "portability-maintainability-and-evolvability",
    "architecture-technology-and-platform-fitness",
    "delivery-runtime-and-dependency-fitness",
    "economics-complexity-and-80-20-tradeoffs",
    "governance-authority-compliance-and-evidence",
    "learning-reuse-and-future-optionality"
  ],
  "desired_evaluation_effects": [
    "material risks exposed",
    "alternatives widened",
    "assumptions challenged",
    "important unknowns surfaced",
    "fit-for-purpose confidence legitimately changed",
    "implementation constraints identified only when materially necessary",
    "better Architect decision support"
  ]
}
