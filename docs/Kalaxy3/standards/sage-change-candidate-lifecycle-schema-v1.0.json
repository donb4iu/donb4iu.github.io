{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kalaxy3.local/sage-change-candidate-lifecycle-schema-v1.0.json",
    "title": "Kalaxy3 SAGE change-candidate lifecycle registry",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "registry_type",
        "lifecycles"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "registry_type": {
            "const": "change-candidate-lifecycle"
        },
        "lifecycles": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/lifecycle"
            }
        }
    },
    "$defs": {
        "status": {
            "enum": [
                "discovery-needed",
                "sized",
                "decision-ready",
                "sequenced",
                "staged-implementation",
                "active",
                "validated",
                "closed",
                "superseded"
            ]
        },
        "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "change_id",
                "current_status",
                "branch",
                "baseline_commit",
                "deployment_gate_required",
                "revalidation_required",
                "history"
            ],
            "properties": {
                "change_id": {
                    "type": "string",
                    "pattern": "^SAGE-CHANGE-[0-9]{8}-[0-9]{3}$"
                },
                "current_status": {
                    "$ref": "#/$defs/status"
                },
                "branch": {
                    "type": "string",
                    "pattern": "^(feature|staged)/[A-Za-z0-9._/-]+$"
                },
                "baseline_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "deployment_gate_required": {
                    "const": true
                },
                "revalidation_required": {
                    "const": true
                },
                "history": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/transition"
                    }
                }
            }
        },
        "transition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sequence",
                "from_status",
                "to_status",
                "transition_type",
                "recorded_at",
                "actor",
                "reason",
                "validation_references",
                "candidate_commit"
            ],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1
                },
                "from_status": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/status"
                        }
                    ]
                },
                "to_status": {
                    "$ref": "#/$defs/status"
                },
                "transition_type": {
                    "enum": [
                        "initial-registration",
                        "status-transition"
                    ]
                },
                "recorded_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "actor": {
                    "type": "string",
                    "minLength": 1
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                },
                "validation_references": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "candidate_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                }
            }
        }
    }
}
