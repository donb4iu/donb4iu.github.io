{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kalaxy3.local/sage-active-session-schema-v1.0.json",
    "title": "Kalaxy3 SAGE active session",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "session_id",
        "change_id",
        "status",
        "branch",
        "baseline_commit",
        "started_at",
        "measurement_boundary",
        "prediction_versions",
        "runtime_ledger",
        "command_storage_policy",
        "deployment_gate"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "session_id": {
            "type": "string",
            "pattern": "^SAGE-SESSION-[0-9]{8}-[0-9]{3}$"
        },
        "change_id": {
            "type": "string",
            "pattern": "^SAGE-CHANGE-[0-9]{8}-[0-9]{3}$"
        },
        "status": {
            "const": "active"
        },
        "branch": {
            "type": "string",
            "pattern": "^(feature|staged)/.+$"
        },
        "baseline_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "started_at": {
            "type": "string",
            "format": "date-time"
        },
        "measurement_boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "included_from",
                "excluded_prior_commands",
                "reason"
            ],
            "properties": {
                "included_from": {
                    "type": "string",
                    "minLength": 1
                },
                "excluded_prior_commands": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "prediction_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "integer",
                "minimum": 1
            }
        },
        "runtime_ledger": {
            "type": "string",
            "pattern": "^\\.sage/active-sessions/SAGE-SESSION-[0-9]{8}-[0-9]{3}/events\\.jsonl$"
        },
        "command_storage_policy": {
            "const": "label-and-digest-only"
        },
        "deployment_gate": {
            "const": "closed"
        }
    },
    "$defs": {
        "command_event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "event_id",
                "event_type",
                "session_id",
                "change_id",
                "phase",
                "command_class",
                "label",
                "command_digest",
                "started_at",
                "completed_at",
                "duration_seconds",
                "exit_code",
                "retry",
                "manual_correction",
                "manual_correction_reason",
                "mutation_opportunity",
                "failure_detected_pre_mutation",
                "known_failure_encountered",
                "known_failure_recurred",
                "applicable_lesson_ids",
                "used_lesson_ids",
                "avoidable_rework_minutes"
            ],
            "properties": {
                "event_id": {
                    "type": "string",
                    "minLength": 1
                },
                "event_type": {
                    "const": "command"
                },
                "session_id": {
                    "$ref": "#/properties/session_id"
                },
                "change_id": {
                    "$ref": "#/properties/change_id"
                },
                "phase": {
                    "type": "string",
                    "minLength": 1
                },
                "command_class": {
                    "enum": [
                        "discovery",
                        "implementation",
                        "repository-mutation",
                        "validation",
                        "evidence",
                        "commit",
                        "push",
                        "recovery"
                    ]
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "command_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "started_at": {
                    "type": "string"
                },
                "completed_at": {
                    "type": "string"
                },
                "duration_seconds": {
                    "type": "number",
                    "minimum": 0
                },
                "exit_code": {
                    "type": "integer"
                },
                "retry": {
                    "type": "boolean"
                },
                "manual_correction": {
                    "type": "boolean"
                },
                "manual_correction_reason": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "mutation_opportunity": {
                    "type": "boolean"
                },
                "failure_detected_pre_mutation": {
                    "type": "boolean"
                },
                "known_failure_encountered": {
                    "type": "boolean"
                },
                "known_failure_recurred": {
                    "type": "boolean"
                },
                "applicable_lesson_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string"
                    }
                },
                "used_lesson_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string"
                    }
                },
                "avoidable_rework_minutes": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0
                }
            }
        },
        "note_event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "event_id",
                "event_type",
                "session_id",
                "change_id",
                "phase",
                "note_type",
                "recorded_at",
                "text"
            ],
            "properties": {
                "event_id": {
                    "type": "string"
                },
                "event_type": {
                    "const": "note"
                },
                "session_id": {
                    "$ref": "#/properties/session_id"
                },
                "change_id": {
                    "$ref": "#/properties/change_id"
                },
                "phase": {
                    "type": "string"
                },
                "note_type": {
                    "enum": [
                        "baseline",
                        "observation",
                        "decision",
                        "limitation",
                        "evidence-gap"
                    ]
                },
                "recorded_at": {
                    "type": "string"
                },
                "text": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
