{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "markdown/standards/sage-domain-capability-gap-set-schema-v1.0.json",
  "title": "Kalaxy3 SAGE domain capability gap set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request",
    "created_at",
    "authority_receipt",
    "component_manifest",
    "gap_count",
    "gaps",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "sage-domain-capability-gap-set"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_receipt": {
      "type": "string",
      "minLength": 1
    },
    "component_manifest": {
      "type": "string",
      "minLength": 1
    },
    "gap_count": {
      "type": "integer",
      "minimum": 1
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required_capability",
          "gap_receipt",
          "gap_receipt_sha256"
        ],
        "properties": {
          "required_capability": {
            "type": "string",
            "minLength": 1
          },
          "gap_receipt": {
            "type": "string",
            "minLength": 1
          },
          "gap_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_by",
        "reviewed_at",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "review-required",
            "approved",
            "rejected"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}
